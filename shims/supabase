#!/bin/sh
# Entry point for git-bash, WSL and any POSIX shell. Those resolve a bare
# `supabase`, never `supabase.cmd`, so this extensionless sibling is what makes
# the guard reachable from an AI agent's shell -- the caller that matters most.
DIR=$(dirname "$0")
exec pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$DIR/supabase.ps1" "$@"
