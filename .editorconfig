# https://editorconfig.org — respecté nativement par VS Code, Cursor, JetBrains.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# cmd.exe supporte mal un .cmd en LF seul. Doit rester cohérent avec
# .gitattributes, qui impose eol=crlf sur ces fichiers.
[*.{cmd,bat}]
end_of_line = crlf

# BOM obligatoire sur les fichiers PowerShell.
#
# Sans lui, Windows PowerShell 5.1 lit un fichier UTF-8 comme de l'ANSI : les
# accents des commentaires deviennent du charabia, et une chaîne accentuée dans
# un message d'erreur aussi. PSScriptAnalyzer le signale (PSUseBOMForUnicodeEncodedFile),
# et le déclarer ici empêche un éditeur de le retirer au prochain enregistrement.
#
# Le shim POSIX `shims/supabase` n'a PAS d'extension et n'est donc pas concerné :
# un BOM devant `#!/bin/sh` casse le shebang.
[*.{ps1,psm1,psd1}]
charset = utf-8-bom

[*.{md,yml,yaml,json}]
indent_size = 2

[*.md]
# Deux espaces en fin de ligne sont un saut de ligne en Markdown.
trim_trailing_whitespace = false
